# Laundry sensor alert configuration
# Copy this file to /etc/laundry-sensor/alerts.env on the Pi and uncomment
# the backend you want to use. Only one ALERT_BACKEND should be active.

# --- AWS SNS (direct SMS, no phone number rental) ---
ALERT_BACKEND=aws_sns
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=us-east-1
ALERT_SMS_TO=+15551234567

# --- Pushover (push notification app, ~$5 one-time) ---
# ALERT_BACKEND=pushover
# PUSHOVER_TOKEN=...
# PUSHOVER_USER=...

# --- ntfy.sh (free push notifications, zero setup) ---
# ALERT_BACKEND=ntfy
# NTFY_TOPIC=my-laundry-sensor
# NTFY_URL=https://ntfy.sh

# --- Twilio (SMS via rented number, ~$1.15/mo) ---
# ALERT_BACKEND=twilio
# TWILIO_SID=...
# TWILIO_TOKEN=...
# TWILIO_FROM=+15559876543
# TWILIO_TO=+15551234567

# --- Generic webhook (JSON POST to any URL) ---
# ALERT_BACKEND=webhook
# WEBHOOK_URL=https://hooks.slack.com/services/...
